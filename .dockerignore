.jitml-pv-lifecycle.claim.lock/
.build/
.data/
.data-preserved*/
.roms/
.git/
node_modules/
package.json
playwright-report/
playwright/node_modules/
playwright/package-lock.json
playwright/test-results/
test-results/
web/node_modules/
web/bower_components/
web/.pulp-cache/
web/output/
web/output-es/
web/dist/
web/generated-docs/
web/.psc-package/
web/.psc*
web/.purs*
web/.psa*
web/.spago
web/.spec-results
web/package-lock.json
dist-newstyle/
