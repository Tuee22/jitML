        tasty,
        tasty-hunit,
        tasty-quickcheck,
        tasty-golden,
        temporary,
        time,
        unix,
        vector,
        zlib,
        JuicyPixels,
        zip-archive

    if flag(cuda)
        cpp-options:     -DJITML_CUDA_BINDINGS=1
        extra-libraries:
            cudart
            cublas
            cudnn

        extra-lib-dirs:  /usr/local/cuda/lib64

executable jitml
    main-is:          Main.hs
    hs-source-dirs:   app
    default-language: GHC2024
    ghc-options:
        -rtsopts -Wall -Wcompat -Werror=incomplete-patterns -O2 -fllvm
        -funbox-strict-fields -threaded -fspecialise-aggressively
        -fexpose-all-unfoldings -with-rtsopts=-A64m -with-rtsopts=-n4m
        -with-rtsopts=-qg1 -with-rtsopts=-qb -with-rtsopts=-T
        -fobject-determinism

    build-depends:
        base >=4.21 && <4.22,
        jitml

