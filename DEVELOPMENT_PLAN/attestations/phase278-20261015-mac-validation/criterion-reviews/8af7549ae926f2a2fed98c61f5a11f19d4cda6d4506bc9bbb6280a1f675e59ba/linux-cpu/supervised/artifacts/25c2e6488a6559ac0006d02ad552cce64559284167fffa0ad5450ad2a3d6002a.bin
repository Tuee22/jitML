  "observations": [
    {
      "path": "src/JitML/Product/SupervisedCohortPlan.hs",
      "reason": "Opaque cohort owns exactly five singleton seed plans0..4; policy and full child transports enter cohort PlanId."
    },
    {
      "path": "src/JitML/Product/SupervisedQualificationPolicy.hs",
      "reason": "Exact ordered5, planned complete work, finite outcomes, joint>=3, median over all5, index0 independently passes signal/improvement/unchanged floor. Finite failed members remain in raw assessment."
    },
    {
      "path": "src/JitML/Product/SupervisedQualification.hs",
      "reason": "Refinement binds original source/lane/row/cohort, dataset-at-read/evaluation digest, each child attempt/PlanId/transport/work, device, actual initial/final bytes and replay. Pure mathematical qualification alone is not authenticated completion."
    },
    {
      "path": "src/JitML/Product/SupervisedQualificationReceipt.hs",
      "reason": "Parent source/executable/invocation and admitted manifest/Store serving replay must match before publication; portable retained data preserves original authenticated identities."
    },
    {
      "path": "src/JitML/Test/ProductScenarioRunner.hs",
      "reason": "Parent computes current source and captures current fixed review before supervised child effects; same source/review and pinned executable are rechecked afterward. Missing/stale review refuses. No child-provided source pin grants authority."
    },
    {
      "path": "src/JitML/Product/CriterionReview.hs",
      "reason": "Actual FILE loader checks fixed source/lane/scope selection, canonical receipt, current full55 contract digest and complete SHA/count artifact closure. It checks integrity, not reviewer independence."
    }
  ],
