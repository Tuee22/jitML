utcomes_required\": 5,\n          \"fixed_budget_completion\": \"All five original members must actually complete300iterations and2457600training transitions each under existing observed-work/counter bindings. Early quality passage grants no early-stop authority; partial/failed work cannot qualify.\",\n          \"fixed_references\": [\n            \"constant-discrete/0\",\n            \"constant-discrete/1\",\n            \"constant-discrete/2\"\n          ],\n          \"joint_success\": \"The SAME original index must have exact final episode-return median strictly greater than its own authentic initial median AND strictly greater than every prescribed task-reference median.\",\n          \"joint_success_minimum\": 3,\n          \"policy\": \"native-return-learning-v2; unchanged current source policy.\",\n          \"prohibitions\": [\n            \"No best-seed substitution\",\n            \"No row/cohort splicing or reuse from old Source8af\",\n            \"No automatic retry\",\n            \"No additional score search\",\n            \"No threshold/reference relaxation\",\n            \"No Phase285 convergence gate added\"\n          ],\n          \"quality_threshold\": {\n            \"comparison\": \">=\",\n            \"literature_target\": -110.0,\n            \"served0\": \"Original index0/seed42 must independently satisfy its own strict learning/reference conditions and final primary metric >= -155.\",\n            \"slack\": 45.0,\n            \"unchanged_floor\": -155.0,\n            \"whole_five\": \"Median of all five original final primary metrics, including finite failures, must be >= -155.\"\n          },\n          \"reference_evaluation\": \"Same raw task dynamics, envInitial(-0.5,0),20episodes,horizon200 and original canonical controller order; no benchmark-specific controller substitution.\",\n          \"serving\": \"Exact original index0 artifact, independently eligible and authenticated; same physical artifact, Store-loaded replay, retained qualification closure, append-only journal and typed lane admission requirements.\"\n        },\n        \"ppo_frozen_recipe\": {\n          \"adam_beta1\": 0.9,\n          \"adam_beta2\": 0.999,\n          \"adam_epsilon\": 1e-08,\n          \"clip_epsilon\": 0.2,\n          \"count_exploration_beta\": 10.0,\n          \"entropy_coefficient\": 0.05,\n          \"environment_and_shaping\": \"All Simulator dynamics, velocity observation scale15, training-only potential shaping scale30, count bonus, true-terminal/truncation/GAE/bootstrap and evaluation rules remain byte-unchanged.\",\n          \"episode_horizon\": 200,\n          \"evaluation_episodes_per_initial_or_final_observation\": 20,\n          \"evaluation_reset\": {\n            \"policy\": \"Greedy argmax on the actual selected substrate MlpDevice; ties retain the lowest original action index; no action resampling/seed selection.\",\n            \"position\": -0.5,\n            \"returns\": \"Raw unshaped simulator reward; same horizon200 and20episodes; invalid device output/evaluation failure remains failure.\",\n            \"selection\": \"Every initial/final/reference episode begins at envInitial; no exploring-start distribution in evaluation.\",\n            \"velocity\": 0.0\n          },\n          \"gamma\": 0.99,\n          \"hidden_activation\": \"tanh\",\n          \"hidden_units\": 256,\n          \"lambda\": 0.95,\n          \"learning_rate\": 0.0005,\n          \"minibatch_size\": 64,\n          \"observation_width\": 2,\n          \"optimizer\": \"Adam\",\n          \"output_semantics\": \"Three policy logits and one unbounded linear value output; existing policy softmax and linear value head unchanged.\",\n          \"output_units\": 4,\n          \"passes_per_update\": 10,\n          \"training_reset\": {\n            \"generator\": \"VecEnv.resetState; two successive uniformR(0,1) draws per reset from the unchanged seed+1 generator sequence.\",\n            \"initial_vector_slots_and_episode_resets\": \"Same envTrainingStart distribution; slot traversal and RNG consumption rules unchanged.\",\n            \"position_formula\": \"-1.2 + u1 * (-0.35 - (-1.2))\",\n            \"position_range\": [\n              -1.2,\n              -0.35\n            ],\n            \"velocity_formula\": \"(u2 - 0.5) * 2 * 0.07\",\n            \"velocity_range\": [\n              -0.07,\n              0.07\n            ]\n          },\n          \"value_coefficient\": 0.5,\n          \"variant\": \"VariantPPO\"\n        },\n        \"ppo_mountain_car_allocation\": {\n          \"indices\": [\n            0,\n            1,\n            2,\n            3,\n            4\n          ],\n          \"iterations\": 300,\n          \"rollout_steps\": 512,\n          \"seeds\": [\n            42,\n            43,\n            44,\n            45,\n            46\n          ],\n          \"served_index\": 0,\n          \"transitions_per_seed\": 2457600,\n          \"vector_environments\": 16,\n          \"whole_five_transitions\": 12288000\n        },\n        \"ppo_report_digest_unchanged\": \"4f128168a4ba25e1f647b995df7b503e59681da84868543cd76e07152cf7fe18\",\n        \"proposal\": {\n          \"bytes\": 13756,\n          \"path\": \".build/phase278-current/proposals/ppo-mountain-car-300-one-trial-20261028/frozen-protocol.json\",\n          \"sha256\": \"db5b804f15291af97cf8b670990327e2fe658630a6cf1da25f59c906bfd0dfc4\"\n        },\n        \"quality_floors_unchanged\": true,\n        \"regression_training_order_contract\": \"generic-regression-training-order-v1:splitmix64-domain-reg-ord1;epoch1-based;original-training-list;sort-key-original-index;whole-example;fixed-heldout;shuffle-root=deriveSplitMixSeed(SplitMixSeed(fromIntegral(execution-seed)),0x7265672d6f726431);epoch-seed=deriveSplitMixSeed(shuffle-root,fromIntegral(one-based-epoch));keys=splitMixWords(length(original-standardized-training-partition),epoch-seed);ordering=ascending(key,zero-based-original-index);epoc