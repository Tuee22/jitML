      "assessment_file": {
        "path": ".build/phase278-current/reviews/prospective/f1381784c66bb54164c9f5f5dc7f3c908fabb8dccd5065a8ce16732a9bfbb968/peer-assessment-post-preservation-ppo300-v2.json",
