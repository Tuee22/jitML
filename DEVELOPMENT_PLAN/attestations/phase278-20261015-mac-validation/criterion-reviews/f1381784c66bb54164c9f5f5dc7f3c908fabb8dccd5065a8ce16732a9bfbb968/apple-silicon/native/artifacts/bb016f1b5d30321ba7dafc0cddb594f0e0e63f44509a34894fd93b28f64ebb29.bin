   \"local_library_pins_join_independently_verified_full_native_inventory\": true,\n      \"external_31_pin_context\": \"Compile-time 31 producer pins are disclosed provenance. The unchanged prospective loader accepts the five explicit repository-local library/plan/conf/cache FILEs; it was not relaxed to external paths. No present-tense assertion about another job changing its external Cabal store is needed.\",\n      \"helper_source\": {\n        \"path\": \"/Users/matthewnowak/jitML/.build/phase278-current/EvidenceHelper.hs\",\n        \"bytes\": 21237,\n        \"sha256\": \"8d44c8f68a3b491b00e62ad1c568e6a65e8d3e71ca398b91150b72a5a388d71b\"\n      },\n      \"helper_binary\": {\n        \"path\": \".build/phase278-current/evidence-helper-ppo300-native-f138-20261028-b3442fce17c5/evidence-helper\",\n        \"bytes\": 185324240,\n        \"sha256\": \"e23db08fad372fef1cf1648546367e08a5eb9b08b4c1120fdb745b2be2892e95\"\n      },\n      \"helper_binary_independent_whole_hash_checked\": true,\n      \"native_CLI_bytes\": 213139616,\n      \"native_CLI_sha256\": \"215fe6ead3bd1d745eaaf837213db4b7fbe85ff842862dca4cfe9c17c43c6f5e\",\n      \"native_backup_inventory\": {\n        \"path\": \"/Users/matthewnowak/jitML/.build/phase278-current/native-state-before-linux-ppo300-f138-20261028-4c9d769dce1f/inventory.json\",\n        \"bytes\": 727080,\n        \"sha256\": \"0b118dff0f054938932597cec4df07a7cba588d1e61502c05b4b0d1cb44bcf0f\"\n      },\n      \"native_backup_independent_filesystem_review\": {\n        \"path\": \"/Users/matthewnowak/jitML/.build/phase278-current/reviews/ppo300-native-restoration-backup-independent-filesystem-review-f138-20261028.json\",\n        \"bytes\": 2501,\n        \"sha256\": \"7e48f7427f31b274597c0d47c3f15f334896ff276bb510bf6808a67335dacbb2\"\n      }\n    },\n    \"finite_math\": {\n      \"classification_n\": 1000,\n      \"uniform_null_alpha\": \"1/5000\",\n      \"independent_integer_binomial_critical_counts\": {\n        \"10\": 136,\n        \"100\": 24,\n        \"200\": 16\n      },\n      \"five_member_Markov_bound_without_seed_independence\": \"5*(1/5000)/3 = 1/3000\",\n      \"thirty_row_context_union_bound\": \"30/3000 = 1/100\",\n      \"scope_limits\": \"Conditional on fixed labels and independent uniform per-example guesses with all five null; no regression/mixed-null/adaptive-retry/population extension.\"\n    }\n  },\n  \"retained_nonpasses_and_scope_limits\": [\n    \"The old 8af/California100 whole-CPU55 exit1 and all four afteroperations exit0 remain literal. Its preservation acceptance, supported DOWN/Stopped and native restoration are cleanup/history facts, not science qualification.\",\n    \"Historical 605/9b/8af criterion contexts and original failure histories remain explicitly historical. The three scientific failed parents remain 1198c911270458eb, 63db61e45f58d4ee and ce1a1fff2f24386f. First-CFA unit85/86 and f138 wrapper expected-count7 versus actual10 nonpass are engineering records, not an additional scientific parent.\",\n    \"The retained bare-name helper compile failure, caller warning, first schema-mismatched Metal-adopter invocation and failed current Linux-unit metadata remain nonpasses; later successful distinct commands do not erase them.\",\n    \"Current Apple Metal engineering30 and native86/10/1 passes do not satisfy any of the 55 current science/serving outcomes. No Linux CPU/CUDA science was run or accepted by this review.\",\n    \"The six frozen status documents are cutoff metadata. This assessment performs no canonical criterion materialization, source/governed-document edit, generator/adopter/runtime/test/build/retry, key/archive/model/attempt payload read, foreign Docker operation or git staging/commit/push.\",\n    \"Final assembler-produced criterion bodies, selectors, receipts and ignore-policy append closure remain subject to their normal exact mechanical consistency checks. This peer record supplies prospective scope judgments; it does not invent future FILE pins or claim those later actions already occurred.\"\n  ],\n  \"author_note_and_actual_inputs\": {\n    \"author_note\": {\n      \"path\": \"/Users/matthewnowak/jitML/.build/phase278-current/reviews/ppo300-f138-ACTUAL-source-bound-author-compatibility-note-20261028.json\",\n      \"bytes\": 34679,\n      \"sha256\": \"ea401a48b62446d6ed9842d3830a82e8fbdc79d6bad3c5b4d7371c94f6e78df8\"\n    },\n    \"actual_inputs\": {\n      \"path\": \"/Users/matthewnowak/jitML/.build/phase278-current/reviews/ppo300-f138-ACTUAL-native-review-inputs-20261028.json\",\n      \"bytes\": 14950,\n      \"sha256\": \"314c5a5d35701ceac7a6fcb5164f9cc254af5a263ee6134dfcd84e4c16df1734\"\n    }\n  },\n  \"unresolved_findings\": [],\n  \"ready_for_existing_scoped_assembler\": true,\n  \"new_training_runs\": 0,\n  \"current_source_qualified_outcomes\": 0\n}\n",
