      "literal_utf8": "{\n  \"domain\": \"jitml-phase278-root-prospective-criterion-assessment-v1\",\n  \"reviewer\": \"/root\",\n  \"source\": {\n    \"algorithm\": 1,\n    \"sha256\": \"576d37311199cb3be896b8511c0e049ea5dc784533976f6c9c386f22a5c28ee1\"\n  },\n  \"authorship_disclosure\": \"Root coordinated implementation, found the actual permission counterexample, applied the reviewed projection fix and final compiler-warning/CLIOutput/format corrections, and ran the native/helper and regression commands. Terminal authored the regression and these drafts plus the inherited terminal-shaping correction; runtime authored the Bootstrap repair. This is an independently reasoned exact prospective criterion assessment, not author-independent implementation approval or human scientific sign-off.\",\n  \"draft_manifest\": {\n    \"path\": \".build/phase278-current/reviews/prospective/576d37311199cb3be896b8511c0e049ea5dc784533976f6c9c386f22a5c28ee1/manifest.json\",\n    \"bytes\": 90069,\n    \"sha256\": \"d94abe3a94b6171705788b5c6d499d1641ed844045e30756c4ad19dea44ac42d\"\n  },\n  \"compatibility_note\": {\n    \"path\": \".build/phase278-current/reviews/compatibility/576d37311199cb3be896b8511c0e049ea5dc784533976f6c9c386f22a5c28ee1/prospective-correctness-criterion-compatibility.json\",\n    \"bytes\": 99831,\n    \"sha256\": \"aa5242b04fbfb57b792ad6b7fed411d942108de98d795566c982e69c95880d59\"\n  },\n  \"full_source_byte_audit\": {\n    \"path\": \".build/phase278-current/reviews/compatibility/576d37311199cb3be896b8511c0e049ea5dc784533976f6c9c386f22a5c28ee1/full-source-pv-projection-byte-audit.json\",\n    \"bytes\": 105996,\n    \"sha256\": \"ede3d77c0ddd4760798b0b24ff52eb48871ceaebb919bb1c494e74cc3fdff049\"\n  },\n  \"source_digest_independent_readback\": {\n    \"algorithm\": 1,\n    \"sha256\": \"576d37311199cb3be896b8511c0e049ea5dc784533976f6c9c386f22a5c28ee1\",\n    \"files\": 605\n  },\n  \"independent_delta_from_actual79_image_source\": {\n    \"changed\": [\n     