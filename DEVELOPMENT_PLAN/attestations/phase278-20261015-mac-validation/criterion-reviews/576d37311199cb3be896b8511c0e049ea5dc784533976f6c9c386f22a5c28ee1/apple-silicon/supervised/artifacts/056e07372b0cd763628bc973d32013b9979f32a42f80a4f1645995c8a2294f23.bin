",\n          \"sha256\": \"7835a3136ace6c3e7d47270db8078e8ff42c7af609a31374adac18b8fc483d1a\"\n        },\n        {\n          \"bytes\": 123324,\n          \"c2_source_sha256\": \"79fd103b30576344544633459e7e12e4dccc8a530bdd9284f7a94a92986a9c36\",\n          \"equals_c2_source_bytes\": false,\n          \"path\": \"test/daemon-lifecycle/Main.hs\",\n          \"sha256\": \"2a2c0746907893b694d292e65c32ff9bf8f628ca59777c564e87fae0bc7cffba\"\n        },\n        {\n          \"bytes\": 45730,\n          \"c2_source_sha256\": \"95aa159a3092b8d837449726eb82fcf728361ee63cfa2849a4cb69f08349916f\",\n          \"equals_c2_source_bytes\": false,\n          \"path\": \"test/e2e/Main.hs\",\n          \"sha256\": \"b4bbac69c85c8e2e8739c6253781eaf804182a2eca4766d65279c420f2d599e5\"\n        },\n        {\n          \"bytes\": 494530,\n          \"c2_source_sha256\": \"24aaf110fe3001f8a26609b378f6740c61687aa7e15f819e83076cd500932ecd\",\n          \"equals_c2_source_bytes\": false,\n          \"path\": \"test/integration/Main.hs\",\n          \"sha256\": \"e88b2a730b4503d211b2f7d26c6f7204482658d9b517f8444d9c2fa0f193447e\"\n        },\n        {\n          \"bytes\": 11407,\n          \"c2_source_sha256\": null,\n          \"equals_c2_source_bytes\": null,\n          \"path\": \"test/shared/DeviceWitnessCoordinate.hs\",\n          \"sha256\": \"92049ae17cd71600676a56cd9df262b11b469aebedb3a9bc4a0ee8b0cc336eb1\"\n        },\n        {\n          \"bytes\": 22820,\n          \"c2_source_sha256\": null,\n          \"equals_c2_source_bytes\": null,\n          \"path\": \"test/shared/StatefulPvProjection.hs\",\n          \"sha256\": \"e4c263381f84368e1fc799da0d8a817290381fa7c7dfd7e5207f2bf05ccadc1a\"\n        },\n        {\n          \"bytes\": 33113,\n          \"c2_source_sha256\": \"81b9bf02dfb732d021d0df2c611595d0a46267c46b03f6f1b320a92a36c73f0a\",\n          \"equals_c2_source_bytes\": false,\n          \"path\": \"test/unit/NativeParentAttemptRetention.hs\",\n          \"sha256\": \"e75dab8ea8669217da960d534913696a20c7e0d30d7e76726ddf927f2f2677ef\"\n        },\n        {\n          \"bytes\": 10754,\n          \"c2_source_sha256\": \"f68e89762b5497e3227882a6d6debcceba1a013d66ca4b541ee0367fec8bb318\",\n          \"equals_c2_source_bytes\": false,\n          \"path\": \"test/unit/NativeParentExecution.hs\",\n          \"sha256\": \"5fcf755874be5fc998ec9845b87343c6d74b074df2ae799ae6ee19fb503af01c\"\n        },\n        {\n          \"bytes\": 8207,\n          \"c2_source_sha256\": \"cc51d7d355e8d4e759d8b8182fd1fbd0e6cfb12c5dcf1e9720a583eea2229f6b\",\n          \"equals_c2_source_bytes\": false,\n          \"path\": \"test/unit/NativeRlExecution.hs\",\n          \"sha256\": \"aee5527dbd3073a4d7e821868aae7b3a29879938db9b98232ac31fb5d77bdb18\"\n        },\n        {\n          \"bytes\": 19044,\n          \"c2_source_sha256\": \"1e196483cf2f1fb1f69a891896ac100bf1dbac3585aa7726c7bb0dfc50c7bd55\",\n          \"equals_c2_source_bytes\": false,\n          \"path\": \"test/unit/OnPolicyHorizon.hs\",\n          \"sha256\": \"e4120e4b65d3ad8cf5be6b3b6bb7d6c5a9f2eb84e23a4aa87b72a9f1ebb0f1b1\"\n        }\n      ],\n      \"domain\": \"jitml-phase278-prospective-source-correctness-criterion-compatibility-v1\",\n      \"findings\": [\n        {\n          \"area\": \"scientific criterion and allocation\",\n          \"basis\": \"All110 ordered row/PlanId/contract objects and both full55 contract-set digests equal actual79 and selected historical C2; all11 policy inputs are byte-identical. The five current source/test deltas change PV metadata projection and its regression wiring, not numerical/scientific policy. Exactly5 original prescribed budget-complete members, at least3 SAME joint own-initial+task/reference successes, unchanged whole5 historical statistic, and independently eligible original served0 remain mandatory.\",\n          \"decision\": \"Unchanged finite criterion applies prospectively to this exact current source/vector, subject to fresh independent assessments\"\n        },\n        {\n          \"area\": \"permission/projection correction\",\n          \"basis\": \"Restore admission intentionally accepts noncanonical permission/ACL metadata. Unconditional later chmod invalidated that invariant; source now initializes only actually new roots and checks real bind identity. The real old-red\\u2192new-five-green is evidence for this narrow implementation claim, not learner convergence or population generalization.\",\n          \"decision\": \"Concrete accepted-metadata preservation bug repaired without criterion or budget change\"\n        },\n        {\n          \"area\": \"historical finite rationale limits\",\n          \"basis\": \"Historical calibrated floors, including Tiny0.008, retain actual provenance. Conditional iid uniform classification calculations do not justify arbitrary model/population/mixed-null/adaptive-retry/native/regression confidence. Exact reference schedules and maximum-only equality limits remain; strict own-initial gain is not equality. Tuning remains seed1729/trials128, disjoint from five-member learning claims.\",\n          \"decision\": \"Retain provenance and do not promote project floors to external published-model claims\"\n        },\n        {\n          \"area\": \"current runtime and qualification\",\n          \"basis\": \"Actual old79 recovery, original-data readbacks, image01076, selected reviews, negative/backend passes, preparatory snapshot and old native results remain their literal original scope. Current source576d requires its own appropriate native/CPU/Apple/runtime/image/lifecycle and exact scientific work/served replay/Store/lane evidence. No outcome is supplied or renewed by this note.\",\n          \"decision\": \"Fresh source-bound validations remain necessary\"\n        }\n      ],\n      \"fresh_projection_semantic_review\": [\n        {\n          \"decision\": \"Preserve accepted existing/root metadata through actual PV projection\",\n          \"files\": [\n            \"src/JitML/Bootstrap.hs\"\n          ],\n          \"review\": \"Existing retained/restored roots, including genuinely empty ones, are no longer chmod/chowned merely because bootstrap runs. Backing and target trailing slashes are stripped before physical-directory/symlink tests. Only successful exclusive new backing-leaf mkdir permits default initialization. Existing file/symlink roots fail closed; a pre-existing target mount must join the exact backing device:inode or the command refuses without overwriting it. Exact current PV coordinates and CPU/Apple producer ownership remain; CUDA arm is unchanged. This repairs permissions/ACL handling after the pre-projection strict restore comparison; it changes no learner, recipe, seed, budget, threshold, completion/retry rule or criterion arithmetic.\"\n        },\n        {\n          \"decision\": \"Meaningful real Linux regression of exact production projection\",\n          \"files\": [\n            \"test/shared/StatefulPvProjection.hs\"\n          ],\n          \"review\": \"I authored this fixture. It gets the exact typed production shell body and changes only the target container operand. Actual production archive/empty/extract programs plus decodeTreeManifest/sameRestoredTree establish a real restrictive02751/access+defaultACL/userxattr/owner/mtime/payload/hardlink/symlink restore. It then verifies full source and mounted-target metadata/identity after projection and repeat, separately covers absent default initialization/existing-empty preservation and file/symlink/wrong-bind refusal. Nonce labelled volumes/immutable image/networknone/readonly root and narrow mount capability are verified before writes; failed red fixtures/raw streams remain retained and successful owned cleanup is verified. Root later fixed two compiler warnings and routes fixture diagnostics through CLIOutput; fixture/assertion semantics remain. This is storage component evidence, never learned-model or substrate hardware evidence.\"\n        },\n        {\n          \"decision\": \"Wire all five real fixture cases without weakening existing daemon body\",\n          \"files\": [\n            \"test/daemon-lifecycle/Main.hs\",\n            \"jitml.cabal\"\n          ],\n          \"review\": \"The shared module is registered in daemon other-modules and its test group appended alongside existing full body, six real service signal/RTS cases, three generic RL and two generic ARS cases. No skip, acceptance override, altered workload command/budget, row filter, retry or training allocation is introduced. A focused Tasty regression run is not the full daemon gate.\"\n        },\n        {\n          \"decision\": \"Keep source producer order/render expectations aligned with root preservation\",\n          \"files\": [\n            \"test/integration/Main.hs\"\n          ],\n          \"review\": \"The renderer assertions follow the same new root-create/physical-directory/bind identity producer and preserve PV preparation before storage manifests/platform releases, CPU+Apple coverage, and unchanged empty-Postgres CUDA behavior. This is a plan-text regression, not a real cluster/restore/learning result.\"\n        },\n        {\n          \"decision\": \"Inherited C2 scientific-provider corrections are byte-identical to previous79 and add no new scientific delta\",\n          \"files\": [\n            \"src/JitML/Test/ProductScenarioRunner.hs\",\n            \"src/JitML/RL/Algorithms/PpoTrainer.hs\"\n          ],\n          \"review\": \"The two scientific provider files which differ from historical C2 have no successor delta. Their existing authentic execution/retained-attempt handling and true-terminal/continuation potential correction remain subject to exact current-work/origin validation; no old source review or outcome is relabelled as current evidence. All remaining65 scientific providers and all11 policy inputs equal the historical C2 byte pins. The new source changes are infrastructure/test wiring only.\"\n        }\n      ],\n      \"full55_lane_vectors\": [\n        {\n          \"contract_set_sha256\": \"555aa3ad727fec53c2e2b361df5f8f10e6c89875c89ed4ca7d1f2cbdc9331b2c\",\n          \"lane\": \"linux-cpu\",\n          \"rows\": [\n            {\n              \"contract_sha256\": \"2b0f0c9427a2b82db3bec2d4e9be83d78c6cef29710b1b806543e8f338666d89\",\n              \"plan_id\": \"8d0e685d27f8718a09aca8d9cde10246d8b46b300107a21c780a567482c1c3d2\",\n              \"row_id\": \"mnist-shallow-mlp\"\n            },\n            {\n              \"contract_sha256\": \"0da5bb7256b5ecd738abdc81c0384d7403525c0a58efcc2e9f1f3dd2b7fc468d\",\n              \"plan_id\": \"7d6c88b9b487aceff26c06d1524ed2ed43acd17e6f8087941ff22dd39228bce0\",\n              \"row_id\": \"mnist-deep-mlp\"\n            },\n            {\n              \"contract_sha256\": \"c2e2393f77655c574ce79fadbd2701e94ca9063673bdbc365f0d4ea35f8683f6\",\n              \"plan_id\": \"cd822dc8fb4f572bd3afd7eb59db68cb8d855c845dcd790ed3752b2201b532d2\",\n              \"row_id\": \"mnist-lenet\"\n            },\n            {\n              \"contract_sha256\": \"7ddf1b2330614ad06aa785b7f853eef3cd42b3bcbd03d1b70e6b62d914484712\",\n              \"plan_id\": \"d9c4e4436dc9428d80a5460f51bc1f0edbf0720e8c0c615610aa138d9e0f9aad\",\n              \"row_id\": \"fashion-mnist-mlp\"\n            },\n            {\n              \"contract_sha256\": \"8afd7429805deec69ceb715b3e6f2dfb37b1161c5d7e6a9d419bcbe0f029c232\",\n              \"plan_id\": \"642dcb131084debf6bccbdd8672317a05944cfc60e132cd7008e91f082e2d011\",\n              \"row_id\": \"fashion-mnist-resnet\"\n            },\n            {\n              \"contract_sha256\": \"e62fd1e34a8a68f8c5b4d03a74230a007f6b97a0d2d2711e6fc13cdc7ed21be3\",\n              \"plan_id\": \"65c19dd44a4aca73e7edc5f3e02b8024384405f510b1eaf16b7db551dbbb7bf3\",\n              \"row_id\": \"cifar10-resnet20\"\n            },\n            {\n              \"contract_sha256